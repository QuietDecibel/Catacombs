<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XTouch.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    <SolidColorBrush x:Key="PanelBrush" Color="#1B1D22" />
    <SolidColorBrush x:Key="StripBrush" Color="#23262C" />
    <SolidColorBrush x:Key="MutedText" Color="#8B909A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Illuminated surface buttons -->
    <Style Selector="Button.led">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="#30343B" />
      <Setter Property="Foreground" Value="#C9CCD3" />
    </Style>
    <Style Selector="Button.led.lit /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2B33D" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="Button.led.red.lit /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF4D4D" />
    </Style>
    <Style Selector="Button.led.green.lit /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#36D16B" />
    </Style>
    <Style Selector="Button.wide">
      <Setter Property="Width" Value="64" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="{StaticResource MutedText}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Application.Styles>
</Application>
