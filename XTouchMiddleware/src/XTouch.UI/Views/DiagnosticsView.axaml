<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XTouch.UI.ViewModels"
             xmlns:dto="using:XTouch.Contracts"
             xmlns:conv="using:XTouch.UI.Converters"
             x:Class="XTouch.UI.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <Grid ColumnDefinitions="*,12,*">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <TextBlock Text="Service log" Classes="h2" VerticalAlignment="Center" Margin="0" />
        <Button Content="Clear" Command="{Binding ClearLogsCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Logs}" FontFamily="{StaticResource MonoFont}" FontSize="11">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="dto:LogEntryDto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Classes="caption" />
              <TextBlock Text="{Binding Level}" Width="86" Foreground="{Binding Level, Converter={x:Static conv:LogLevelToBrushConverter.Instance}}" />
              <TextBlock Text="{Binding Category}" Width="130" Classes="caption" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
        <TextBlock Text="MIDI trace" Classes="h2" VerticalAlignment="Center" Margin="0" />
        <ToggleSwitch IsChecked="{Binding TraceEnabled}" OnContent="On" OffContent="Off" />
        <CheckBox IsChecked="{Binding HideMeters}" Content="Hide meters" />
        <Button Content="Clear" Command="{Binding ClearTraceCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Trace}" FontFamily="{StaticResource MonoFont}" FontSize="11">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="dto:MidiTraceDto">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss.fff}'}" Classes="caption" />
              <TextBlock Text="{Binding Direction}" Width="30" />
              <TextBlock Text="{Binding Hex}" Width="200" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Description}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
