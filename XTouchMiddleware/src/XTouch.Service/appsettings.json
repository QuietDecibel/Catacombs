{
  "Surface": {
    "Transport": "Midi",
    "InputPortName": "X-TOUCH",
    "OutputPortName": "X-TOUCH",
    "BlankOnShutdown": true
  },
  "Targets": {
    "X32": {
      "Host": "",
      "Port": 10023,
      "Emulator": false,
      "EmulatorPort": 10023
    }
  },
  "Profiles": {
    "Directory": "profiles",
    "Active": "x32-default"
  },
  "Api": {
    "Url": "http://127.0.0.1:5280",
    "Token": null
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/xtouch-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  }
}
